<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the simulation exactly as Unity will see it (netstandard2.1, C# 9, no UnityEngine),
    so it can be built and tested without the Editor. Unity ignores this folder.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Hearthline.Sim</AssemblyName>
    <RootNamespace>Hearthline.Sim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Hearthline/Sim/**/*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="YamlDotNet">
      <HintPath>../../../Assets/Plugins/YamlDotNet/YamlDotNet.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
