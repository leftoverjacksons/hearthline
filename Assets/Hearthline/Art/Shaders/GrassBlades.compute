// Places grass blades around a camera every frame (ADR 0033). One thread per cell of a grid that moves with the
// camera in whole cells, so a blade keeps its spot, shape and colour as you walk. The grass map says where grass
// grows (r density, g height, b dryness); the height map is the ground mesh's vertex heights, read with the same
// triangles as the mesh so blades sit exactly on the ground. Blades thin out and widen with distance, shrink into
// the ground at the edge of the field, and are skipped off screen. Survivors are written for GrassBlade.shader,
// drawn with one indirect draw.
#pragma kernel Reset
#pragma kernel Place
#pragma kernel Finish

struct Blade
{
    float4 rootFacing; // root position, facing angle
    float4 shape;      // height, width, bend, per-blade random
    float4 extra;      // ground normal x, ground normal z, dryness, clump random
};

RWStructuredBuffer<Blade> _Blades;
RWByteAddressBuffer _Args; // vertex count per blade, blade count, start vertex, start instance

Texture2D<float4> _GrassMap;
Texture2D<float> _HeightMap;
SamplerState linearClampSampler;

float4 _GrassRect;  // origin x, origin z, size
float4 _HeightRect; // origin x, origin z, cell size, vertices per side
float4 _Eye;        // camera position
float4 _Grid;       // first cell x, first cell z, cells per side, cell size
float4 _Shape;      // min height, max height, width, clump size
float4 _Distance;   // full-density distance, radius, thinning exponent, width growth
float4 _Planes[6];  // camera frustum, normals pointing in
float _Density;
uint _Capacity;
uint _VertsPerBlade;

uint Hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352dU;
    x ^= x >> 15; x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}
uint Hash2(int2 c) { return Hash((uint)c.x * 73856093U ^ Hash((uint)c.y * 19349663U)); }
float Rand(uint h) { return (h & 0xFFFFFFU) / 16777216.0; }

void GroundAt(float2 xz, out float y, out float3 normal)
{
    float2 q = (xz - _HeightRect.xy) / _HeightRect.z;
    int last = (int)_HeightRect.w - 2;
    int2 i = clamp((int2)floor(q), 0, last);
    float2 f = saturate(q - i);
    float h00 = _HeightMap.Load(int3(i, 0));
    float h10 = _HeightMap.Load(int3(i + int2(1, 0), 0));
    float h01 = _HeightMap.Load(int3(i + int2(0, 1), 0));
    float h11 = _HeightMap.Load(int3(i + int2(1, 1), 0));
    // The ground mesh splits each cell along the diagonal from (1,0) to (0,1).
    y = f.x + f.y <= 1.0
        ? h00 + f.x * (h10 - h00) + f.y * (h01 - h00)
        : h11 + (1.0 - f.x) * (h01 - h11) + (1.0 - f.y) * (h10 - h11);
    float dx = ((h10 - h00) + (h11 - h01)) * 0.5 / _HeightRect.z;
    float dz = ((h01 - h00) + (h11 - h10)) * 0.5 / _HeightRect.z;
    normal = normalize(float3(-dx, 1.0, -dz));
}

[numthreads(1, 1, 1)]
void Reset(uint3 id : SV_DispatchThreadID)
{
    _Args.Store4(0, uint4(_VertsPerBlade, 0, 0, 0));
}

[numthreads(8, 8, 1)]
void Place(uint3 id : SV_DispatchThreadID)
{
    uint n = (uint)_Grid.z;
    if (id.x >= n || id.y >= n) return;
    int2 cell = int2(_Grid.xy) + int2(id.xy);
    uint h = Hash2(cell);
    float2 xz = (float2(cell) + float2(Rand(h), Rand(Hash(h + 1)))) * _Grid.w;

    float d = distance(xz, _Eye.xz);
    if (d > _Distance.y) return;
    float2 uv = (xz - _GrassRect.xy) / _GrassRect.z;
    if (any(uv < 0.0) || any(uv > 1.0)) return;
    float4 g = _GrassMap.SampleLevel(linearClampSampler, uv, 0);

    // Fewer blades further away, each wider, so the field keeps its cover (Ghost of Tsushima's trick).
    float thin = d < _Distance.x ? 1.0 : pow(abs(_Distance.x / d), _Distance.z);
    if (Rand(Hash(h + 2)) >= g.r * _Density * thin) return;

    // Clumps: blades near the same Voronoi point share height, lean and colour, so the field has patches.
    float2 p = xz / _Shape.w;
    int2 base = (int2)floor(p);
    float best = 1e9;
    uint clump = 0;
    for (int dz = -1; dz <= 1; dz++)
    for (int dx = -1; dx <= 1; dx++)
    {
        int2 c = base + int2(dx, dz);
        uint hc = Hash2(c + int2(7919, 104729));
        float2 fp = float2(c) + float2(Rand(hc), Rand(Hash(hc + 1)));
        float dd = dot(fp - p, fp - p);
        if (dd < best) { best = dd; clump = hc; }
    }
    float clumpScale = lerp(0.7, 1.3, Rand(Hash(clump + 2)));
    float clumpFacing = Rand(Hash(clump + 3)) * 6.2831853;

    float rim = smoothstep(_Distance.y, _Distance.y * 0.5, d); // shrink into the ground toward the edge
    float height = lerp(_Shape.x, _Shape.y, g.g) * clumpScale * lerp(0.6, 1.1, Rand(Hash(h + 3))) * rim;
    if (height < 0.03) return;
    float width = _Shape.z * lerp(0.7, 1.3, Rand(Hash(h + 4))) * lerp(0.85, 1.35, g.g) * pow(max(thin, 0.04), -_Distance.w);

    float y;
    float3 normal;
    GroundAt(xz, y, normal);
    float3 root = float3(xz.x, y - 0.03, xz.y);

    float3 centre = root + float3(0.0, height * 0.5, 0.0);
    float radius = height + width + 0.3;
    [unroll] for (int k = 0; k < 6; k++)
        if (dot(_Planes[k].xyz, centre) + _Planes[k].w < -radius) return;

    uint index;
    _Args.InterlockedAdd(4, 1, index);
    if (index >= _Capacity) return;

    float facing = lerp(Rand(Hash(h + 5)) * 6.2831853, clumpFacing, 0.45);
    Blade b;
    b.rootFacing = float4(root, facing);
    b.shape = float4(height, width, lerp(0.12, 0.5, Rand(Hash(h + 6))), Rand(Hash(h + 7)));
    b.extra = float4(normal.x, normal.z, g.b, Rand(Hash(clump + 4)));
    _Blades[index] = b;
}

[numthreads(1, 1, 1)]
void Finish(uint3 id : SV_DispatchThreadID)
{
    _Args.Store(4, min(_Args.Load(4), _Capacity));
}
