# Asset Store packs: licensed per user, never committed to this public repo. See docs/SETUP.md.
/Assets/ThirdParty/StarterAssets/
/Assets/ThirdParty/StarterAssets.meta

# Reference images (mostly other people's work); only the README is committed. See ArtReference/README.md.
/ArtReference/*
!/ArtReference/README.md

# Blender backup files
*.blend1

# Mixamo animations: Adobe's terms don't allow redistributing the raw files. See docs/SETUP.md.
/Assets/ThirdParty/Mixamo/
/Assets/ThirdParty/Mixamo.meta

# Downloaded archives (e.g. the MakeHuman asset pack for MPFB): install them, don't commit them.
/Assets/*.zip
/Assets/*.zip.meta
/Assets/ThirdParty/RockFREE/
/Assets/ThirdParty/RockFREE.meta

# Unity regenerates this when it upgrades the rocks pack terrain; derived from git-ignored files.
/Assets/_TerrainAutoUpgrade/
/Assets/_TerrainAutoUpgrade.meta
/Assets/ThirdParty/UltimateNature/
/Assets/ThirdParty/UltimateNature.meta

# Tripo characters: kept out of the public repo until the licence is confirmed (docs/NEEDS.md)
/ArtSource/Characters/femaleTest1/
/Assets/Hearthline/Art/Characters/FemaleTest1/
/Assets/Hearthline/Art/Characters/FemaleTest1.meta
/Screenshots/
